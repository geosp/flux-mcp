# Copy to .env. Generate a token with: openssl rand -hex 32
FLUX_MCP_TOKEN=

# Base URL clients use to open full-resolution images
FLUX_PUBLIC_BASE_URL=http://10.0.0.96:8300

# Unload ComfyUI's models after this many idle seconds (0 = keep them loaded)
FLUX_IDLE_UNLOAD_S=600

# Host ports
FLUX_MCP_PORT=8300
COMFYUI_PORT=8188

# Shared model store (diffusion_models/, text_encoders/, vae/)
MODELS_DIR=/mnt/shared/huggingface/comfyui

# Optional, only for downloading the gated FLUX 3 Klein weights
# HF_TOKEN=
